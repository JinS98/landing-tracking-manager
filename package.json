{
  "name": "landing-tracking-manager",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev": "npm run dev -w @ltm/admin",
    "build": "npm run build:sdk && node scripts/prepare-sdk.mjs && npm run build -w @ltm/admin",
    "build:sdk": "npm run build -w @ltm/tracking-sdk",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --experimental-strip-types --test tests/mvp.test.mjs tests/access.test.mjs tests/registration-cli.test.mjs tests/import.test.mjs tests/tracking-config.test.mjs tests/google-adapters.test.mjs tests/naver-adapter.test.mjs tests/social-adapters.test.mjs tests/public-config.test.mjs tests/sdk-init.test.mjs tests/sdk-conversion.test.mjs tests/script-editor.test.mjs",
    "test:ui": "node --test tests/admin-ui.test.mjs",
    "test:landing": "npm run build:sdk && node --experimental-strip-types --test tests/landing-integration.test.mjs",
    "test:hosting": "firebase emulators:exec --only hosting --project demo-landing-tracking-manager \"node --test tests/hosting-smoke.test.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-landing-tracking-manager \"node --test tests/firestore-rules.test.mjs\"",
    "test:registration": "firebase emulators:exec --only firestore --project demo-landing-tracking-manager \"node --experimental-strip-types --test tests/registration-firestore.test.mjs\"",
    "test:public-config": "firebase emulators:exec --only firestore --project demo-landing-tracking-manager \"node --experimental-strip-types --test tests/public-config-firestore.test.mjs\"",
    "test:release": "firebase emulators:exec --only firestore --project demo-landing-tracking-manager \"node --experimental-strip-types --test tests/release-firestore.test.mjs\"",
    "test:api": "firebase emulators:exec --only firestore --project demo-landing-tracking-manager \"node --experimental-strip-types --test tests/admin-api-firestore.test.mjs\"",
    "test:stack": "firebase emulators:exec --only firestore,functions,hosting --project demo-landing-tracking-manager \"node --test tests/functions-hosting-emulator.test.mjs\""
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
